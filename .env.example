# ---------------------------------------------------------------------------
# CallLens environment. Copy to .env and fill in.
# Without NEBIUS_API_KEY the app runs in MOCK mode (canned replies, no network).
# ---------------------------------------------------------------------------

# Nebius Token Factory — https://studio.nebius.ai  ->  API keys
# OpenAI-compatible base URL. Do not add /chat/completions here.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=

# Model IDs. Copy the EXACT ids from your Token Factory model list
# (run `npm run models` to print what your key can see).
# The values below are placeholders and may not match your account.
NEBIUS_MODEL_FAST=nvidia/nemotron-3-nano
NEBIUS_MODEL_MAIN=nvidia/nemotron-3-super
NEBIUS_MODEL_DEEP=nvidia/nemotron-3-ultra

# Optional: live web context for the caller's company / product mentions.
# Without it, the context panel simply stays empty.
TAVILY_API_KEY=

# Optional overrides
PORT=3000
# Set to 1 to force mock mode even when an API key is present (demo safety).
MOCK_MODELS=0
# Per-request ceiling so a slow model can never hang the demo.
REQUEST_TIMEOUT_MS=25000
